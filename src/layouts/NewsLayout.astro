---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Badge from '../components/ui/Badge.astro';
import RelatedNews from '../components/news/RelatedNews.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';

interface Props {
  article: CollectionEntry<'news'>;
  relatedArticles: CollectionEntry<'news'>[];
}

const { article, relatedArticles } = Astro.props;
const { title, date, category, summary, pdfUrl, tags } = article.data;

const categoryLabels: Record<string, string> = {
  'exploration-results':  'Exploration Results',
  'corporate-update':     'Corporate Update',
  'financial-disclosure': 'Financial Disclosure',
  'agm':                  'AGM',
  'management-change':    'Management Change',
  'property-update':      'Property Update',
  'capital-markets':      'Capital Markets',
};

const dateStr = new Date(date + 'T12:00:00').toLocaleDateString('en-CA', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  datePublished: date,
  description: summary,
  publisher: {
    '@type': 'Organization',
    name: 'Fitzroy Minerals Ltd.',
    url: 'https://fitzroyminerals.com',
  },
};
---

<BaseLayout title={title} description={summary}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="breadcrumb-bar">
    <div class="container">
      <Breadcrumbs items={[
        { label: 'News', href: '/news' },
        { label: title },
      ]} />
    </div>
  </div>

  <article class="news-article">
    <div class="container">

      <!-- Article header -->
      <header class="article-header">
        <div class="article-header__meta">
          <Badge label={categoryLabels[category] ?? category} variant={category} />
          <time datetime={date} class="article-header__date">{dateStr}</time>
        </div>
        <h1 class="article-header__title">{title}</h1>
        <p class="article-header__summary">{summary}</p>
        {pdfUrl && (
          <div class="article-header__pdf">
            <ExternalLink href={pdfUrl} label="Download News Release (PDF)" class="pdf-link" />
          </div>
        )}
        {tags && tags.length > 0 && (
          <ul class="article-header__tags" role="list">
            {tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
        )}
      </header>

      <!-- Article body + sidebar -->
      <div class="article-layout">
        <div class="article-body prose">
          <slot />
        </div>

        <aside class="article-sidebar">
          {pdfUrl && (
            <div class="sidebar-widget">
              <p class="sidebar-widget__label">Download</p>
              <ExternalLink
                href={pdfUrl}
                label="News Release (PDF) ↗"
                class="sidebar-pdf-link"
              />
            </div>
          )}
          <div class="sidebar-widget">
            <p class="sidebar-widget__label">Share</p>
            <p class="sidebar-widget__tickers">TSX-V: FTZ &nbsp;|&nbsp; OTC: FTZFF</p>
          </div>
          <div class="sidebar-widget">
            <p class="sidebar-widget__label">Investor Relations</p>
            <a href="mailto:mmj@fitzroyminerals.com" class="sidebar-contact">
              mmj@fitzroyminerals.com
            </a>
          </div>
        </aside>
      </div>

      <!-- Related news -->
      {relatedArticles.length > 0 && (
        <div class="article-related">
          <RelatedNews articles={relatedArticles} heading="Related News Releases" />
        </div>
      )}

    </div>
  </article>
</BaseLayout>

<style>
  .breadcrumb-bar {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-3);
  }

  .news-article { padding-block: var(--space-10) var(--space-16); }

  /* Header */
  .article-header {
    max-width: 760px;
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .article-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .article-header__date {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .article-header__title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    color: var(--color-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .article-header__summary {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    font-style: italic;
  }

  .article-header__pdf {
    padding-top: var(--space-1);
  }

  .pdf-link {
    font-weight: 600;
    color: var(--color-accent);
    font-size: 0.9375rem;
  }

  .article-header__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: 0.2em 0.7em;
    border-radius: 999px;
  }

  /* Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: var(--space-10);
    align-items: start;
  }

  /* Prose */
  .prose {
    min-width: 0;
    color: var(--color-text);
    line-height: 1.8;
  }

  .prose :global(h2) {
    font-size: 1.375rem;
    color: var(--color-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .prose :global(p) {
    margin-bottom: var(--space-5);
    font-size: 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .prose :global(li) { font-size: 1rem; line-height: 1.7; }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin-block: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .prose :global(th) {
    background: var(--color-primary);
    color: #fff;
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .prose :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .prose :global(tr:last-child td) { border-bottom: none; }
  .prose :global(tr:nth-child(even) td) { background: var(--color-bg-alt); }

  .prose :global(em) { color: var(--color-text-muted); }
  .prose :global(strong) { font-weight: 700; color: var(--color-primary); }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: var(--space-3) var(--space-5);
    margin-inline: 0;
    background: var(--color-bg-alt);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-8);
  }

  /* Sidebar */
  .article-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .sidebar-widget {
    padding: var(--space-4);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar-widget__label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-accent);
  }

  .sidebar-pdf-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .sidebar-widget__tickers {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .sidebar-contact {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    word-break: break-all;
    transition: color 0.15s;
  }

  .sidebar-contact:hover { color: var(--color-accent); }

  /* Related */
  .article-related {
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 860px) {
    .article-layout { grid-template-columns: 1fr; }
    .article-sidebar { position: static; }
  }
</style>
