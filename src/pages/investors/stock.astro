---
import InvestorsLayout from '../../layouts/InvestorsLayout.astro';
import StockWidget from '../../components/investors/StockWidget.svelte';
import ExternalLink from '../../components/ui/ExternalLink.astro';
import { stockTickers } from '../../data/stockTickers';

const tickers = [
  { symbol: stockTickers.tsxv.symbol, exchange: stockTickers.tsxv.exchange, label: 'TSX-V' },
  { symbol: stockTickers.otc.symbol,  exchange: stockTickers.otc.exchange,  label: 'OTC' },
];
---

<InvestorsLayout
  title="Stock Information"
  description="Fitzroy Minerals stock information — TSX-V: FTZ and OTC: FTZFF."
  pageHeading="Stock Information"
  pageIntro="Fitzroy Minerals Ltd. trades on the TSX Venture Exchange under the symbol FTZ and on the OTC Markets under FTZFF."
>
  <div class="stock-grid">
    <section class="stock-section">
      <h2 class="stock-exchange">
        <span class="exchange-badge">TSX-V</span>
        {stockTickers.tsxv.symbol}
      </h2>
      <StockWidget tickers={[tickers[0]]} client:load />
      <div class="stock-links">
        <ExternalLink href={stockTickers.tsxv.quoteUrl} label="View on TSX Venture Exchange" />
      </div>
    </section>

    <section class="stock-section">
      <h2 class="stock-exchange">
        <span class="exchange-badge exchange-badge--otc">OTC</span>
        {stockTickers.otc.symbol}
      </h2>
      <StockWidget tickers={[tickers[1]]} client:load />
      <div class="stock-links">
        <ExternalLink href={stockTickers.otc.quoteUrl} label="View on OTC Markets" />
      </div>
    </section>
  </div>

  <section class="stock-disclaimer">
    <p>
      Share price information is provided for informational purposes only and is not guaranteed to be
      accurate, complete, or timely. Fitzroy Minerals does not accept liability for any trading decisions
      made based on this information. For regulatory filings, please visit{' '}
      <ExternalLink href="https://www.sedarplus.ca/" label="SEDAR+" />.
    </p>
  </section>
</InvestorsLayout>

<style>
  .stock-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .stock-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stock-exchange {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.375rem;
    color: var(--color-primary);
  }

  .exchange-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--color-primary);
    color: #fff;
    padding: 0.25em 0.6em;
    border-radius: var(--radius-sm);
  }

  .exchange-badge--otc { background: var(--color-text-muted); }

  .stock-links { font-size: 0.875rem; }

  .stock-disclaimer {
    padding: var(--space-5);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  @media (max-width: 700px) {
    .stock-grid { grid-template-columns: 1fr; }
  }
</style>
