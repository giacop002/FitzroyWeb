---
import { getCollection } from 'astro:content';
import InvestorsLayout from '../../layouts/InvestorsLayout.astro';
import ShareStructureTable from '../../components/investors/ShareStructureTable.astro';
import DocumentCard from '../../components/investors/DocumentCard.astro';
import StockWidget from '../../components/investors/StockWidget.svelte';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { stockTickers } from '../../data/stockTickers';
import { contactInfo } from '../../data/contactInfo';

const allDocs = await getCollection('documents');

const latestPresentation = allDocs
  .filter((d) => d.data.category === 'corporate-presentation')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))[0];

const latestFinancials = allDocs
  .filter((d) => d.data.category === 'financial-statement' || d.data.category === 'mda')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 2);

const technicalReport = allDocs.find((d) => d.data.category === 'technical-report');

const quickLinks = [
  { label: 'Stock Information',  href: '/investors/stock',            icon: '📈' },
  { label: 'Share Structure',    href: '/investors/share-structure',  icon: '🧾' },
  { label: 'Presentations',      href: '/investors/presentations',    icon: '📊' },
  { label: 'Financials',         href: '/investors/financials',       icon: '📋' },
  { label: 'Technical Reports',  href: '/investors/technical-reports',icon: '🔬' },
  { label: 'AGM',                href: '/investors/agm',              icon: '🗓️' },
  { label: 'Media & Research',   href: '/investors/media',            icon: '🎥' },
  { label: 'LIFE Offering',      href: '/investors/life-offering',    icon: '📄' },
];

const tickers = [
  { symbol: stockTickers.tsxv.symbol, exchange: stockTickers.tsxv.exchange, label: 'TSX-V' },
  { symbol: stockTickers.otc.symbol,  exchange: stockTickers.otc.exchange,  label: 'OTC' },
];
---

<InvestorsLayout
  title="Investor Relations"
  description="Investor relations hub for Fitzroy Minerals — stock information, presentations, financials, technical reports, and more."
  pageHeading="Investor Relations"
  pageIntro="Access all investor materials: stock quotes, corporate presentations, financial statements, technical reports, and AGM information."
>
  <!-- Stock Widget -->
  <section class="ir-section">
    <SectionHeader title="Stock Information" ctaLabel="Full quote" ctaHref="/investors/stock" />
    <StockWidget {tickers} client:load />
  </section>

  <!-- Quick Links -->
  <section class="ir-section">
    <SectionHeader title="Investor Materials" />
    <div class="quicklinks-grid">
      {quickLinks.map((link) => (
        <a href={link.href} class="quicklink">
          <span class="quicklink__icon" aria-hidden="true">{link.icon}</span>
          <span class="quicklink__label">{link.label}</span>
          <span class="quicklink__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Two column: Share Structure + Latest Presentation -->
  <div class="ir-two-col">
    <section class="ir-section">
      <SectionHeader title="Share Structure" ctaLabel="Full details" ctaHref="/investors/share-structure" />
      <ShareStructureTable />
    </section>

    {latestPresentation && (
      <section class="ir-section">
        <SectionHeader title="Latest Presentation" ctaLabel="All presentations" ctaHref="/investors/presentations" />
        <DocumentCard document={latestPresentation} />
      </section>
    )}
  </div>

  <!-- Latest Financials -->
  {latestFinancials.length > 0 && (
    <section class="ir-section">
      <SectionHeader title="Recent Filings" ctaLabel="All financials" ctaHref="/investors/financials" />
      <div class="doc-list">
        {latestFinancials.map((doc) => <DocumentCard document={doc} variant="row" />)}
      </div>
    </section>
  )}

  <!-- Technical Report -->
  {technicalReport && (
    <section class="ir-section">
      <SectionHeader title="Technical Report" ctaLabel="All reports" ctaHref="/investors/technical-reports" />
      <DocumentCard document={technicalReport} />
    </section>
  )}

  <!-- IR Contact -->
  <section class="ir-section">
    <SectionHeader title="Contact Investor Relations" />
    <div class="ir-contact">
      <div class="ir-contact__item">
        <span class="ir-contact__label">CEO &amp; President</span>
        <span class="ir-contact__name">{contactInfo.ceo.name}</span>
        <a href={`mailto:${contactInfo.ceo.email}`} class="ir-contact__link">
          {contactInfo.ceo.email}
        </a>
        <a href={`tel:${contactInfo.ceo.phone}`} class="ir-contact__link">
          {contactInfo.ceo.phone}
        </a>
      </div>
      <div class="ir-contact__item">
        <span class="ir-contact__label">Head Office</span>
        <span class="ir-contact__name">{contactInfo.headOffice.company}</span>
        <span class="ir-contact__addr">
          {contactInfo.headOffice.address},<br />
          {contactInfo.headOffice.city}, {contactInfo.headOffice.province} {contactInfo.headOffice.postalCode}
        </span>
      </div>
    </div>
  </section>
</InvestorsLayout>

<style>
  .ir-section { margin-bottom: var(--space-12); }

  .quicklinks-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .quicklink {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    background: var(--color-bg);
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .quicklink:hover {
    box-shadow: var(--shadow-sm);
    border-color: var(--color-accent);
  }

  .quicklink__icon { font-size: 1.25rem; flex-shrink: 0; }

  .quicklink__label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    flex: 1;
    line-height: 1.3;
  }

  .quicklink__arrow {
    color: var(--color-accent);
    opacity: 0;
    font-size: 1rem;
    transition: opacity 0.15s;
    flex-shrink: 0;
  }

  .quicklink:hover .quicklink__arrow { opacity: 1; }

  .ir-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-12);
  }

  .doc-list {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .ir-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .ir-contact__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-alt);
  }

  .ir-contact__label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-accent);
  }

  .ir-contact__name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .ir-contact__link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .ir-contact__link:hover { color: var(--color-accent); }

  .ir-contact__addr {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .quicklinks-grid { grid-template-columns: repeat(2, 1fr); }
    .ir-two-col { grid-template-columns: 1fr; }
    .ir-contact { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .quicklinks-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
