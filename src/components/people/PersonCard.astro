---
interface Props {
  name: string;
  role: string;
  shortBio: string;
  roleCategory: string;
  otherRoles?: string[];
}

const { name, role, shortBio, otherRoles } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('');
---

<div class="person-card">
  <div class="person-card__avatar" aria-hidden="true">{initials}</div>
  <div class="person-card__body">
    <p class="person-card__name">{name}</p>
    <p class="person-card__role">{role}</p>
    <p class="person-card__bio">{shortBio}</p>
    {otherRoles && otherRoles.length > 0 && (
      <ul class="person-card__other" role="list">
        {otherRoles.map((r) => <li>{r}</li>)}
      </ul>
    )}
  </div>
</div>

<style>
  .person-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    height: 100%;
  }

  .person-card__avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .person-card__name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.3;
  }

  .person-card__role {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }

  .person-card__bio {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-top: var(--space-2);
  }

  .person-card__other {
    list-style: none;
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .person-card__other li {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding-left: 0.75em;
    position: relative;
  }

  .person-card__other li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
</style>
