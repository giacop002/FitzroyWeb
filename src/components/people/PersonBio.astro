---
interface Props {
  name: string;
  role: string;
  roleCategory: string;
  otherRoles?: string[];
  photo?: string;
}

const { name, role, otherRoles, photo } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('');
---

<article class="person-bio">
  <!-- Left: photo / avatar + identity -->
  <div class="person-bio__sidebar">
    <div class="person-bio__photo-wrap">
      {photo
        ? <img src={photo} alt={name} class="person-bio__photo" width="120" height="120" />
        : <div class="person-bio__avatar" aria-hidden="true">{initials}</div>
      }
    </div>
    <div class="person-bio__identity">
      <h3 class="person-bio__name">{name}</h3>
      <p class="person-bio__role">{role}</p>
      {otherRoles && otherRoles.length > 0 && (
        <ul class="person-bio__other" role="list">
          {otherRoles.map((r) => <li>{r}</li>)}
        </ul>
      )}
    </div>
  </div>

  <!-- Right: bio prose -->
  <div class="person-bio__content prose">
    <slot />
  </div>
</article>

<style>
  .person-bio {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-8);
    align-items: start;
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .person-bio:last-child { border-bottom: none; }

  /* Sidebar */
  .person-bio__sidebar {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .person-bio__photo-wrap {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
  }

  .person-bio__photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .person-bio__avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .person-bio__identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .person-bio__name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.3;
  }

  .person-bio__role {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .person-bio__other {
    list-style: none;
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .person-bio__other li {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    padding-left: 0.75em;
    position: relative;
  }

  .person-bio__other li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  /* Bio prose */
  .person-bio__content.prose {
    color: var(--color-text);
    line-height: 1.8;
    font-size: 0.9375rem;
  }

  .person-bio__content.prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .person-bio__content.prose :global(p:last-child) { margin-bottom: 0; }

  /* Mobile: stack vertically */
  @media (max-width: 640px) {
    .person-bio {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .person-bio__sidebar {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: var(--space-4);
    }

    .person-bio__photo-wrap {
      width: 72px;
      height: 72px;
      flex-shrink: 0;
    }

    .person-bio__avatar {
      width: 72px;
      height: 72px;
      font-size: 1.5rem;
    }
  }
</style>
