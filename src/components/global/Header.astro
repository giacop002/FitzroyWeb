---
import MainNav from './MainNav.astro';
import MobileMenu from './MobileMenu.svelte';
import { siteConfig } from '../../data/siteConfig';
---

<header class="site-header">
  <div class="container header-inner">

    <!-- Logo -->
    <a href="/" class="logo" aria-label={`${siteConfig.siteName} — Home`}>
      <img
        src="/assets/fitzroy-minerals-logo-white.png"
        alt={siteConfig.siteName}
        class="logo-img"
        width="160"
        height="40"
      />
    </a>

    <!-- Ticker — centered between logo and nav -->
    <a href="/investors" class="header-ticker" id="header-ticker">
      <span id="ticker-ftz">TSX-V: FTZ $0.41 CAD</span>
      &nbsp;|&nbsp;
      <span id="ticker-ftzff">OTC: FTZFF $0.29 USD</span>
    </a>

    <script>
      async function updateTicker() {
        const CACHE_KEY = 'ftz_ticker_cache';
        const CACHE_TTL = 60 * 60 * 1000; // 1 hora

        const cached = localStorage.getItem(CACHE_KEY);
        if (cached) {
          try {
            const { ts, ftz, ftzff } = JSON.parse(cached);
            if (Date.now() - ts < CACHE_TTL) {
              applyPrices(ftz, ftzff);
              return;
            }
          } catch {}
        }

        try {
          const res = await fetch('/api/ticker');
          if (!res.ok) return;
          const { ftz, ftzff } = await res.json();
          if (ftz && ftzff) {
            localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), ftz, ftzff }));
            applyPrices(ftz, ftzff);
          }
        } catch {
          // Silently keep hardcoded fallback values
        }
      }

      function applyPrices(ftz: number, ftzff: number) {
        const elFtz   = document.getElementById('ticker-ftz');
        const elFtzff = document.getElementById('ticker-ftzff');
        if (elFtz)   elFtz.textContent   = `TSX-V: FTZ $${ftz.toFixed(2)} CAD`;
        if (elFtzff) elFtzff.textContent = `OTC: FTZFF $${ftzff.toFixed(2)} USD`;
      }

      updateTicker();
    </script>

    <!-- Desktop nav -->
    <div class="desktop-nav">
      <MainNav />
    </div>

    <!-- Mobile -->
    <div class="mobile-controls">
      <MobileMenu pathname={Astro.url.pathname} client:load />
    </div>

  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header-height);
    background: var(--color-primary);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: var(--space-6);
  }

  /* Logo */
  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    height: 42px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Ticker — pushes itself to centre with auto margins */
  .header-ticker {
    flex: 1;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent-light);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .header-ticker:hover { opacity: 0.8; }

  /* Nav sits at the right */
  .desktop-nav {
    display: flex;
    flex-shrink: 0;
  }

  .mobile-controls { display: none; }

  @media (max-width: 768px) {
    .desktop-nav { display: none; }
    .mobile-controls { display: flex; align-items: center; }
    .header-ticker { display: none; }
  }
</style>
