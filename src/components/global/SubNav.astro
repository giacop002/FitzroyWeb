---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const pathname = Astro.url.pathname;

function isActive(href: string) {
  return pathname === href || pathname.startsWith(href + '/');
}
---

<nav class="subnav" aria-label="Section navigation">
  <div class="container">
    <ul class="subnav-list" role="list">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['subnav-link', { 'subnav-link--active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .subnav {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: var(--header-height);
    z-index: 20;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .subnav .container { padding-block: 0; }

  .subnav-list {
    list-style: none;
    display: flex;
    gap: 0;
    min-width: max-content;
  }

  .subnav-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    margin-bottom: -1px;
  }

  .subnav-link:hover { color: var(--color-primary); }

  .subnav-link--active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    font-weight: 600;
  }
</style>
