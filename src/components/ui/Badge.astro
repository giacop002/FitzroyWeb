---
type Stage = 'early-stage' | 'target-generation' | 'active-drilling' | 'resource-definition' | 'prefeasibility' | 'on-hold';
type Category = 'exploration-results' | 'corporate-update' | 'financial-disclosure' | 'agm' | 'management-change' | 'property-update' | 'capital-markets';

interface Props {
  label: string;
  variant?: Stage | Category | 'default';
}

const { label, variant = 'default' } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`]}>{label}</span>

<style>
  .badge {
    display: inline-block;
    padding: 0.2em 0.65em;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    border-radius: 999px;
    white-space: nowrap;
    line-height: 1.5;
  }

  .badge--default              { background: #e5e7eb; color: #374151; }
  .badge--active-drilling      { background: #dcfce7; color: #166534; }
  .badge--resource-definition  { background: #dbeafe; color: #1e40af; }
  .badge--target-generation    { background: #fef3c7; color: #92400e; }
  .badge--early-stage          { background: #f3f4f6; color: #4b5563; }
  .badge--prefeasibility       { background: #ede9fe; color: #5b21b6; }
  .badge--on-hold              { background: #fee2e2; color: #991b1b; }
  .badge--exploration-results  { background: #dcfce7; color: #166534; }
  .badge--corporate-update     { background: #dbeafe; color: #1e40af; }
  .badge--financial-disclosure { background: #fef3c7; color: #92400e; }
  .badge--agm                  { background: #ede9fe; color: #5b21b6; }
  .badge--management-change    { background: #fce7f3; color: #9d174d; }
  .badge--property-update      { background: #f0fdf4; color: #14532d; }
  .badge--capital-markets      { background: #fff7ed; color: #9a3412; }
</style>
