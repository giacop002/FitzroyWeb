---
interface Props {
  label: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  external?: boolean;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  label,
  href,
  variant = 'primary',
  external = false,
  size = 'md',
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const externalProps = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...externalProps}
>
  {label}
  {external && <span aria-hidden="true" class="ext-icon">↗</span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    text-decoration: none;
    border: 2px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s, box-shadow 0.15s;
    white-space: nowrap;
    font-family: inherit;
    line-height: 1;
  }

  .btn--sm { padding: var(--space-2) var(--space-4); font-size: 0.8125rem; }
  .btn--md { padding: var(--space-3) var(--space-6); font-size: 0.9375rem; }
  .btn--lg { padding: var(--space-4) var(--space-8); font-size: 1rem; }

  .btn--primary {
    background: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }
  .btn--primary:hover {
    background: var(--color-accent-light);
    border-color: var(--color-accent-light);
    box-shadow: 0 4px 12px rgba(193, 127, 58, 0.35);
  }

  .btn--secondary {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }
  .btn--secondary:hover {
    background: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
  }

  .btn--outline {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-border-dark);
  }
  .btn--outline:hover {
    border-color: var(--color-primary);
    background: var(--color-bg-alt);
  }

  .ext-icon { font-size: 0.75em; opacity: 0.8; }
</style>
